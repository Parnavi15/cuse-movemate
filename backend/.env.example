DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me
# Optional: enables Claude-powered parsing of "what do I need?" requests.
# Leave unset and the deterministic rule parser handles it instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Email delivery for student verification codes -------------------------
# Leave EMAIL_HOST_USER blank and codes print to the console instead.
#
# Gmail (easiest): turn on 2-Step Verification, then create an App Password at
# myaccount.google.com/apppasswords and paste the 16 characters with no spaces.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Cuse-MoveMate <you@gmail.com>

# Outlook / Office 365 instead of Gmail:
#   EMAIL_HOST=smtp.office365.com
#   EMAIL_PORT=587
# Note: many university tenants disable SMTP auth, so sending FROM an @syr.edu
# account often fails. Sending TO @syr.edu works from any provider.

# Optional: better geocoding. Without it, OpenStreetMap's Nominatim is used,
# which needs no key. Enable "Geocoding API" on the key in Google Cloud.
GOOGLE_MAPS_API_KEY=

# Optional: restrict signup to another campus.
MOVEMATE_STUDENT_DOMAINS=syr.edu
